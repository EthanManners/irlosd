# irlosd settings. Copy to .env and fill in STREAM_KEY.

# Where the stream goes. STREAM_SERVER defaults to Kick.
STREAM_KEY=
# STREAM_SERVER=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app/

# The field feed IrlosStudio pulls for the Live scene (empty: no feed yet, BRB card only).
SRT_URL=

# Automatic Live/Low/BRB switching from SRT Live Server stats (empty: off).
SLS_STATS_URL=
SLS_PUBLISHER=publish/live/feed1
# LOW_KBPS=800
# LOW_RTT_MS=2500
# OFFLINE_KBPS=0

# Output.
# RESOLUTION=1920x1080
# FPS=30
# BITRATE_KBPS=6000
